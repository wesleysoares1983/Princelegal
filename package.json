{
  "name": "contratos-juridicos",
  "version": "0.1.0",
  "private": true,
  "description": "Gestao de Contratos Juridicos - Princesa dos Campos",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unidade",
    "test:banco": "vitest run --project banco",
    "test:tudo": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "drizzle-kit migrate",
    "db:teste:subir": "node testes/docker.mjs subir",
    "db:teste:parar": "node testes/docker.mjs parar"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.4",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "14.23.0-beta.17",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
