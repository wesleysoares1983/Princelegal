{
  "name": "contratos-juridicos",
  "version": "0.1.0",
  "private": true,
  "description": "Gestao de Contratos Juridicos - Princesa dos Campos",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unidade",
    "test:banco": "vitest run --project banco",
    "test:tudo": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npm run worker:build && node dist/semear.cjs",
    "db:teste:subir": "node testes/docker.mjs subir",
    "db:teste:parar": "node testes/docker.mjs parar",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "npm run worker:build && node dist/worker.cjs",
    "alertas:simular": "npm run worker:build && node dist/worker.cjs alertas --simular",
    "alertas:agora": "npm run worker:build && node dist/worker.cjs alertas"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "next": "16.4.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "14.23.0-beta.17",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}