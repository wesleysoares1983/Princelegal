APPS_PRINCESA_URL=<string>
APPS_INTERNAL_KEY=<string>
APP_ID=<number>
# Assina o cookie de sessao. Minimo 32 caracteres; gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<string>

POSTGRES_HOST=<string>
POSTGRES_PORT=<number>
POSTGRES_DATABASE=<string>
POSTGRES_USERNAME=<string>
POSTGRES_PASSWORD=<string>

SMTP_HOST=<string>
SMTP_PORT=<number>
SMTP_USER=<string>
SMTP_PASSWORD=<string>
# Adicionais do e-mail/alertas:
SMTP_FROM=<string>        # remetente; sem ele, usa SMTP_USER
APP_URL=<string>          # endereço do app nos links dos e-mails (ex.: http://contratos.intranet)
ALERTAS_ATIVOS=true       # false desliga os e-mails (ex.: homologação)
ALERTAS_CRON=0 7 * * *    # horário do envio diário (Brasília) Sem SMTP_HOST, os e-mails viram arquivos .eml em .dados/emails (desenvolvimento).

# Arquivos enviados (desenvolvimento: .dados/arquivos; no Docker é fixo em /data/arquivos).
ARMAZENAMENTO_DIR=<string>
UPLOAD_MAX_MB=25          # tamanho máximo de um documento; no Docker, mudar exige rebuild
LOG_LEVEL=info

# Contratos do Protheus (sincronizados 1x por dia; cache em .dados/protheus, no Docker fixo em /data/protheus).
PROTHEUS_CONTRACTS_URL=https://api.princesadoscampos.com.br/api/protheus/contracts   # opcional; este é o padrão
PROTHEUS_CONTRACTS_TOKEN=<string>   # sem ele a tela mostra "integração não configurada"
PROTHEUS_CACHE_DIR=<string>     # opcional fora do Docker
PROTHEUS_CRON=0 9 * * *         # horário da sincronização diária (Brasília), feita pelo worker

# Só produção (docker-compose.yml) -- passo a passo em DEPLOY.md:
APP_PORTA=3400                  # porta neste host para onde o proxy reverso encaminha
ARQUIVOS_DIR=./dados/arquivos   # pasta do host com os documentos (dono uid 1001; entra no backup da TI)
TAG=latest                      # rótulo da imagem construída
NODE_IMAGE=node:24-alpine       # imagem base; troque se o Docker Hub estiver bloqueado na rede
